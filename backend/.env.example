# Supabase Database
# Get these from: Supabase Dashboard > Project Settings > Database
# Use the "Connection string" > "URI" format, replace [YOUR-PASSWORD] with your db password
# For async Python, use postgresql+asyncpg:// instead of postgresql://
SUPABASE_DB_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase API (for direct client access)
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# LiveKit
LIVEKIT_URL=wss://your-app.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Speech-to-Text (choose one)
ASSEMBLYAI_API_KEY=your-assemblyai-key
# DEEPGRAM_API_KEY=your-deepgram-key

# Text-to-Speech (choose one)
CARTESIA_API_KEY=your-cartesia-key
# ELEVENLABS_API_KEY=your-elevenlabs-key

# Integrations (optional)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C...
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=...

# App Settings
APP_ENV=development
LOG_LEVEL=INFO

# Cronometer Integration
CRONOMETER_ENCRYPTION_KEY=
